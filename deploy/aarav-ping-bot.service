[Unit]
Description=Aarav Ping Bot (Slack Socket Mode)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=aaravbot
Group=aaravbot
WorkingDirectory=/opt/aarav-ping-bot
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/etc/aarav-ping-bot.env
ExecStart=/usr/bin/node /opt/aarav-ping-bot/src/app.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
