{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "Aarav Ping Bot",
    "description": "A small Slack bot with ping, help, and mention replies.",
    "background_color": "#4A154B"
  },
  "features": {
    "bot_user": {
      "display_name": "Aarav Ping Bot",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/aarav-ping",
        "description": "Check whether Aarav Ping Bot is responding.",
        "should_escape": false
      },
      {
        "command": "/aarav-help",
        "description": "Show Aarav Ping Bot's available functions.",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "commands",
        "app_mentions:read",
        "channels:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "is_hosted": false,
    "token_rotation_enabled": false
  }
}
